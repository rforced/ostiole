# - internal/collections/named.go: NamedCollectionNames.FindString looked
#   up keys without lowercasing, so ARGS_NAMES:Key with uppercase letters
#   silently never matched. Lowercase the key when the collection is
#   case-insensitive, matching Map.FindString.
#   Upstream: PR #1757 (2026-10-14), open at 1cfa4f9.
diff --git a/internal/collections/named.go b/internal/collections/named.go
index 6d6c922..0a155a3 100644
--- a/internal/collections/named.go
+++ b/internal/collections/named.go
@@ -131,6 +131,13 @@ func (c *NamedCollectionNames) FindRegex(key *regexp.Regexp) []types.MatchData {
 }
 
 func (c *NamedCollectionNames) FindString(key string) []types.MatchData {
+	// Changed by Ostiole: lowercase ARGS_NAMES lookup key like ARGS (upstream PR #1757).
+	// The map stores lowercased keys unless it is case-sensitive, so the
+	// lookup key must follow suit, as Map.FindString does; otherwise
+	// ARGS_NAMES:User never matches anything.
+	if !c.collection.isCaseSensitive {
+		key = strings.ToLower(key)
+	}
 	data, ok := c.collection.data[key]
 	if !ok || len(data) == 0 {
 		return nil
