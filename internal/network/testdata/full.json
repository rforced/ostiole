{
  "version": 7,
  "system": {
    "hostname": "edge",
    "management": {
      "webPort": 8443,
      "sshPort": 22,
      "logDefaultDrops": true
    }
  },
  "zones": [
    {
      "name": "wan",
      "description": "Internet",
      "external": true
    },
    {
      "name": "lan",
      "description": "Local",
      "antiLockout": true,
      "logDrops": true
    },
    {
      "name": "dmz",
      "description": "Servers"
    },
    {
      "name": "guest",
      "description": "Zone with no interfaces"
    }
  ],
  "interfaces": [
    {
      "name": "eth0",
      "zone": "wan",
      "enabled": true,
      "ipv4": {
        "mode": "dhcp",
        "sendHostname": true
      },
      "ipv6": {
        "mode": "slaac",
        "temporaryAddresses": true
      },
      "macAddress": "02:1a:2b:3c:4d:5e"
    },
    {
      "name": "eth1",
      "zone": "lan",
      "enabled": true,
      "ipv4": {
        "mode": "static",
        "address": "192.168.1.1/24"
      },
      "ipv6": {
        "mode": "static",
        "address": "2001:db8:1::1/64"
      }
    },
    {
      "name": "eth1.20",
      "zone": "lan",
      "enabled": true,
      "vlan": {
        "parent": "eth1",
        "id": 20
      },
      "ipv4": {
        "mode": "static",
        "address": "192.168.20.1/24"
      },
      "ipv6": {
        "mode": "none"
      }
    },
    {
      "name": "eth2",
      "zone": "dmz",
      "enabled": true,
      "ipv4": {
        "mode": "static",
        "address": "10.10.0.1/24"
      },
      "ipv6": {
        "mode": "none"
      }
    },
    {
      "name": "eth3",
      "zone": "dmz",
      "enabled": false,
      "ipv4": {
        "mode": "none"
      },
      "ipv6": {
        "mode": "none"
      }
    },
    {
      "name": "wg0",
      "zone": "lan",
      "description": "Road warriors",
      "enabled": true,
      "ipv4": {
        "mode": "static",
        "address": "10.66.0.1/24"
      },
      "ipv6": {
        "mode": "none"
      },
      "mtu": 1420,
      "wireguard": {
        "privateKey": "yAnz5TF+lXXJte14tji3zlMNq+hd2rYUIgJBgB3fBmk=",
        "publicKey": "HIgo9xNzJMWLKASShiTqIybxZ0U3wGLiUeJ1PKf8ykw=",
        "listenPort": 51820,
        "peers": [
          {
            "name": "laptop",
            "enabled": true,
            "publicKey": "xTIBA5rboUvnH4htodjb6e697QjLERt1NAB4mZqp8Dg=",
            "presharedKey": "FpCyhws9cxwWoV4xELtfJvjJN+zQVRPISllRWgeopVE=",
            "allowedIps": [
              "10.66.0.2/32"
            ],
            "keepalive": 25
          },
          {
            "name": "branch",
            "enabled": true,
            "publicKey": "TrMvSoP4jYQlY6RIzBgbssQqY3vxI2Pi+y71lOWWXX0=",
            "allowedIps": [
              "10.66.0.3/32",
              "192.168.99.0/24"
            ],
            "endpoint": "branch.example.net:51820",
            "keepalive": 25
          },
          {
            "name": "retired",
            "enabled": false,
            "publicKey": "qrgPmY/H7JXcqLsFj4hWKHl5XVJxzVMkPwhZmVm6L0c=",
            "allowedIps": [
              "10.66.0.9/32"
            ]
          }
        ]
      }
    }
  ],
  "aliases": [
    {
      "name": "servers",
      "type": "hosts",
      "description": "Web \"servers\"",
      "entries": [
        "10.10.0.5",
        "10.10.0.0/24",
        "2001:db8:2::/64"
      ]
    },
    {
      "name": "v4only",
      "type": "hosts",
      "entries": [
        "172.16.0.0/12"
      ]
    },
    {
      "name": "empty",
      "type": "hosts",
      "entries": []
    },
    {
      "name": "web",
      "type": "ports",
      "entries": [
        "80",
        "443",
        "8000-8100"
      ]
    }
  ],
  "rules": [
    {
      "id": "allow-lan",
      "description": "Allow LAN to any",
      "enabled": true,
      "zone": "lan",
      "action": "accept",
      "protocol": "any",
      "source": {},
      "destination": {}
    },
    {
      "id": "web-from-servers",
      "enabled": true,
      "zone": "dmz",
      "action": "accept",
      "protocol": "tcp+udp",
      "source": {
        "alias": "servers"
      },
      "destination": {
        "portAlias": "web"
      }
    },
    {
      "id": "block-smtp",
      "enabled": true,
      "zone": "lan",
      "destZone": "wan",
      "action": "reject",
      "protocol": "tcp",
      "log": true,
      "source": {},
      "destination": {
        "ports": [
          "25",
          "465-587"
        ]
      }
    },
    {
      "id": "dns-to-self",
      "enabled": true,
      "zone": "dmz",
      "action": "accept",
      "protocol": "udp",
      "source": {},
      "destination": {
        "self": true,
        "ports": [
          "53"
        ]
      }
    },
    {
      "id": "ping",
      "enabled": true,
      "zone": "wan",
      "action": "accept",
      "protocol": "icmp",
      "source": {},
      "destination": {}
    },
    {
      "id": "mixed-families",
      "enabled": true,
      "zone": "dmz",
      "action": "drop",
      "protocol": "any",
      "source": {
        "addresses": [
          "10.0.0.1",
          "10.1.0.0/16",
          "2001:db8::1",
          "2001:db8:5::/48"
        ]
      },
      "destination": {
        "addresses": [
          "192.168.1.0/24"
        ]
      }
    },
    {
      "id": "v6-only-dest",
      "enabled": true,
      "zone": "lan",
      "action": "accept",
      "protocol": "tcp",
      "source": {
        "alias": "v4only"
      },
      "destination": {
        "addresses": [
          "2001:db8:9::1"
        ],
        "ports": [
          "22"
        ]
      }
    },
    {
      "id": "empty-alias",
      "enabled": true,
      "zone": "lan",
      "action": "accept",
      "protocol": "any",
      "source": {
        "alias": "empty"
      },
      "destination": {}
    },
    {
      "id": "disabled",
      "enabled": false,
      "zone": "lan",
      "action": "accept",
      "protocol": "any",
      "source": {},
      "destination": {}
    },
    {
      "id": "to-guest",
      "enabled": true,
      "zone": "lan",
      "destZone": "guest",
      "action": "accept",
      "protocol": "any",
      "source": {},
      "destination": {}
    },
    {
      "id": "udp-sport",
      "enabled": true,
      "zone": "wan",
      "action": "accept",
      "protocol": "udp",
      "source": {
        "ports": [
          "123"
        ]
      },
      "destination": {
        "ports": [
          "123"
        ]
      }
    },
    {
      "id": "reject-udp",
      "enabled": true,
      "zone": "lan",
      "action": "reject",
      "protocol": "udp",
      "source": {},
      "destination": {}
    }
  ],
  "nat": {
    "outbound": {
      "mode": "manual",
      "rules": [
        {
          "id": "nat-lan",
          "enabled": true,
          "zone": "wan",
          "source": [
            "192.168.0.0/16",
            "2001:db8:1::/64"
          ]
        },
        {
          "id": "nat-all",
          "enabled": true,
          "zone": "wan"
        },
        {
          "id": "nat-off",
          "enabled": false,
          "zone": "wan"
        },
        {
          "id": "nat-guest",
          "enabled": true,
          "zone": "guest"
        }
      ]
    },
    "portForwards": [
      {
        "id": "pf-web",
        "enabled": true,
        "zone": "wan",
        "protocol": "tcp",
        "ports": [
          "80",
          "443"
        ],
        "target": "10.10.0.5"
      },
      {
        "id": "pf-ssh",
        "enabled": true,
        "zone": "wan",
        "protocol": "tcp",
        "ports": [
          "2222"
        ],
        "target": "10.10.0.6",
        "targetPort": "22"
      },
      {
        "id": "pf-game",
        "enabled": true,
        "zone": "wan",
        "protocol": "tcp+udp",
        "ports": [
          "27015-27020"
        ],
        "target": "192.168.1.50"
      },
      {
        "id": "pf-v6",
        "enabled": true,
        "zone": "wan",
        "protocol": "udp",
        "ports": [
          "5000"
        ],
        "target": "2001:db8:2::10",
        "targetPort": "5001"
      },
      {
        "id": "pf-guest",
        "enabled": true,
        "zone": "guest",
        "protocol": "tcp",
        "ports": [
          "1"
        ],
        "target": "10.0.0.1"
      },
      {
        "id": "pf-off",
        "enabled": false,
        "zone": "wan",
        "protocol": "tcp",
        "ports": [
          "2"
        ],
        "target": "10.0.0.1"
      }
    ]
  },
  "routes": [
    {
      "id": "rt1",
      "enabled": true,
      "destination": "10.200.0.0/16",
      "gateway": "10.10.0.254",
      "interface": "eth2"
    }
  ]
}
