==> 00-ostiole-eth0.network <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
[Match]
Name=eth0

[Network]
DHCP=ipv4
LLMNR=no
MulticastDNS=no
LLDP=no
EmitLLDP=no
IPv6AcceptRA=yes
KeepConfiguration=dhcp-on-stop

[DHCPv4]
SendHostname=no
ClientIdentifier=mac
UseHostname=no
RouteMetric=10

[DHCPv6]
DUIDType=link-layer

[IPv6AcceptRA]
Token=prefixstable
RouteMetric=10
