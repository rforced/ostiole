{
  "version": 5,
  "system": { "dnsServers": ["8.8.8.8"], "management": { "webPort": 443, "sshPort": 22 } },
  "zones": [{ "name": "wan", "external": true }, { "name": "lan", "antiLockout": true }],
  "interfaces": [
    { "name": "eth0", "zone": "wan", "enabled": true, "ipv4": { "mode": "dhcp" }, "ipv6": { "mode": "none" } },
    { "name": "eth1", "zone": "lan", "enabled": true, "ipv4": { "mode": "static", "address": "10.0.0.1/24" }, "ipv6": { "mode": "none" } }
  ],
  "rules": [],
  "nat": { "outbound": { "mode": "automatic" } },
  "services": {
    "dhcp": { "enabled": true, "servers": [{ "interface": "eth1", "enabled": true, "rangeStart": "10.0.0.50", "rangeEnd": "10.0.0.99", "gateway": "10.0.0.254", "dns": ["9.9.9.9"], "domain": "office" }] },
    "dns": { "enabled": false }
  }
}
