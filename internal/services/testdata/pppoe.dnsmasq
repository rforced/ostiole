==> ostiole.conf <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
no-resolv
no-hosts
no-poll
bind-dynamic
addn-hosts=/etc/dnsmasq.d/ostiole.hosts
dhcp-leasefile=/var/lib/dnsmasq/ostiole.leases
interface=lan0
domain-needed
bogus-priv
localise-queries
listen-address=127.0.0.1
cache-size=10000
stop-dns-rebind
rebind-localhost-ok
rebind-domain-ok=/lan/
server=1.1.1.1
domain=lan
local=/lan/
expand-hosts
conf-file=/etc/dnsmasq.d/ostiole.block.conf
dhcp-authoritative
quiet-dhcp
quiet-dhcp6
quiet-ra
dhcp-range=set:s_lan0,192.168.1.100,192.168.1.199,255.255.255.0,24h
dhcp-option=tag:s_lan0,option:router,192.168.1.1
dhcp-option=tag:s_lan0,option:dns-server,192.168.1.1
dhcp-option=tag:s_lan0,option:domain-name,lan
==> ostiole.enabled <==
1
==> ostiole.hosts <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
==> resolv.conf <==
# Generated by ostiole.
nameserver 127.0.0.1
search lan
