==> ostiole.conf <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
ext_ifname=eth0
listening_ip=eth1
http_port=2189
enable_upnp=yes
enable_natpmp=yes
secure_mode=yes
ipv6_disable=yes
system_uptime=yes
clean_ruleset_interval=600
uuid=00000000-0000-5000-8000-000000000000
upnp_table_name=ostiole
upnp_nat_table_name=ostiole
upnp_forward_chain=upnp_forward
upnp_nat_chain=upnp_prerouting
upnp_nat_postrouting_chain=upnp_postrouting
allow 1024-65535 192.168.1.0/24 1024-65535
deny 0-65535 0.0.0.0/0 0-65535
