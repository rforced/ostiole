==> ostiole-ppp0 <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
plugin rp-pppoe.so
nic-eth0
ifname ppp0
user "someone@isp.example"
password "a \"quoted\" secret"
rp_pppoe_service "internet"
noauth
hide-password
persist
maxfail 0
holdoff 5
mtu 1492
mru 1492
lcp-echo-interval 5
lcp-echo-failure 3
defaultroute
defaultroute-metric 10
replacedefaultroute
+ipv6
usepeerdns
