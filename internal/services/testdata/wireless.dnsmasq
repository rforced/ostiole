==> ostiole.conf <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
no-resolv
no-hosts
no-poll
bind-dynamic
addn-hosts=/etc/dnsmasq.d/ostiole.hosts
dhcp-leasefile=/var/lib/dnsmasq/ostiole.leases
interface=br-lan
interface=ap1
domain-needed
bogus-priv
localise-queries
listen-address=127.0.0.1
server=9.9.9.9
domain=home.arpa
local=/home.arpa/
expand-hosts
conf-file=/etc/dnsmasq.d/ostiole.block.conf
dhcp-authoritative
dhcp-range=set:s_br_lan,10.88.0.100,10.88.0.199,255.255.255.0,12h
dhcp-option=tag:s_br_lan,option:router,10.88.0.1
dhcp-option=tag:s_br_lan,option:dns-server,10.88.0.1
dhcp-option=tag:s_br_lan,option:domain-name,home.arpa
dhcp-range=set:s_ap1,10.99.0.100,10.99.0.199,255.255.255.0,2h
dhcp-option=tag:s_ap1,option:router,10.99.0.1
dhcp-option=tag:s_ap1,option:dns-server,10.99.0.1
dhcp-option=tag:s_ap1,option:domain-name,home.arpa
==> ostiole.enabled <==
1
==> ostiole.hosts <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
==> resolv.conf <==
# Generated by ostiole.
nameserver 127.0.0.1
search home.arpa
