==> ostiole.conf <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
no-resolv
no-hosts
no-poll
bind-dynamic
addn-hosts=/etc/dnsmasq.d/ostiole.hosts
dhcp-leasefile=/var/lib/dnsmasq/ostiole.leases
interface=eth1
port=0
dhcp-authoritative
quiet-dhcp
quiet-dhcp6
quiet-ra
dhcp-range=set:s_eth1,10.0.0.50,10.0.0.99,255.255.255.0,24h
dhcp-option=tag:s_eth1,option:router,10.0.0.254
dhcp-option=tag:s_eth1,option:dns-server,9.9.9.9
dhcp-option=tag:s_eth1,option:domain-name,office
dhcp-ignore-names=tag:s_eth1
==> ostiole.enabled <==
1
==> ostiole.hosts <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
==> resolv.conf <==
# Generated by ostiole.
nameserver 8.8.8.8
