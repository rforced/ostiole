==> dnsmasq.conf <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
no-resolv
no-hosts
no-poll
bind-dynamic
addn-hosts=/var/lib/ostiole/dnsmasq/hosts
dhcp-leasefile=/var/lib/ostiole/dnsmasq.leases
port=0
interface=eth1
dhcp-authoritative
dhcp-range=set:s_eth1,10.0.0.50,10.0.0.99,255.255.255.0,12h
dhcp-option=tag:s_eth1,option:router,10.0.0.254
dhcp-option=tag:s_eth1,option:dns-server,9.9.9.9
dhcp-option=tag:s_eth1,option:domain-name,office
==> dnsmasq.enabled <==
1
==> hosts <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
==> resolv.conf <==
# Generated by ostiole.
nameserver 8.8.8.8
