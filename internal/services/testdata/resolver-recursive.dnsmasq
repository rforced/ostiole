==> ostiole.conf <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
no-resolv
no-hosts
no-poll
bind-dynamic
addn-hosts=/etc/dnsmasq.d/ostiole.hosts
dhcp-leasefile=/var/lib/dnsmasq/ostiole.leases
interface=eth1
interface=eth1.20
interface=eth2
domain-needed
bogus-priv
localise-queries
listen-address=127.0.0.1
cache-size=10000
stop-dns-rebind
rebind-localhost-ok
rebind-domain-ok=/lan/nas.example.com/ts.net/
server=127.0.0.53#53
proxy-dnssec
server=/ts.net/100.100.100.100
domain=lan
local=/lan/
expand-hosts
conf-file=/etc/dnsmasq.d/ostiole.block.conf
dhcp-authoritative
quiet-dhcp
quiet-dhcp6
quiet-ra
dhcp-range=set:s_eth1,192.168.1.100,192.168.1.199,255.255.255.0,12h
dhcp-option=tag:s_eth1,option:router,192.168.1.1
dhcp-option=tag:s_eth1,option:dns-server,192.168.1.1
dhcp-option=tag:s_eth1,option:domain-name,lan
dhcp-ignore-names=tag:s_eth1
enable-ra
dhcp-range=set:s6_eth1,::100,::1ff,constructor:eth1,64,6h
dhcp-ignore-names=tag:dhcpv6,tag:eth1
dhcp-option=tag:s6_eth1,option6:dns-server,[2001:db8:1::1]
dhcp-option=tag:s6_eth1,option6:domain-search,lan
dhcp-range=set:s6_eth1_20,::,constructor:eth1.20,ra-only,64,24h
dhcp-option=tag:s6_eth1_20,option6:dns-server,[::]
dhcp-option=tag:s6_eth1_20,option6:domain-search,lan
dhcp-host=aa:bb:cc:dd:ee:ff,192.168.1.50,[::50],nas
dhcp-host=aa:bb:cc:dd:ee:01,[2001:db8:1::99],vault
==> ostiole.enabled <==
1
==> ostiole.hosts <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
192.168.1.60 printer
192.168.1.50 nas
2001:db8:1::99 vault
==> resolv.conf <==
# Generated by ostiole.
nameserver 127.0.0.1
search lan
