==> ostiole.conf <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
no-resolv
no-hosts
no-poll
bind-dynamic
user=dnsmasq
pid-file=
addn-hosts=/etc/dnsmasq.d/ostiole.hosts
dhcp-leasefile=/var/lib/dnsmasq/ostiole.leases
interface=eth1
domain-needed
bogus-priv
localise-queries
listen-address=127.0.0.1
cache-size=10000
stop-dns-rebind
rebind-localhost-ok
rebind-domain-ok=/home.arpa/
server=9.9.9.9
domain=home.arpa
local=/home.arpa/
expand-hosts
conf-file=/etc/dnsmasq.d/ostiole.block.conf
==> ostiole.enabled <==
1
==> ostiole.hosts <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
==> resolv.conf <==
# Generated by ostiole.
nameserver 127.0.0.1
search home.arpa
