==> ostiole.conf <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
no-resolv
no-hosts
no-poll
bind-dynamic
addn-hosts=/etc/dnsmasq.d/ostiole.hosts
dhcp-leasefile=/var/lib/dnsmasq/ostiole.leases
interface=eth1
interface=eth2
interface=eth3
domain-needed
bogus-priv
localise-queries
listen-address=127.0.0.1
cache-size=10000
stop-dns-rebind
rebind-localhost-ok
rebind-domain-ok=/lan/
server=9.9.9.9
domain=lan
local=/lan/
expand-hosts
conf-file=/etc/dnsmasq.d/ostiole.block.conf
dhcp-authoritative
quiet-dhcp
quiet-dhcp6
quiet-ra
dhcp-range=set:s_eth1,192.168.1.100,192.168.1.199,255.255.255.0,24h
dhcp-option=tag:s_eth1,option:router,192.168.1.1
dhcp-option=tag:s_eth1,option:dns-server,192.168.1.1
dhcp-option=tag:s_eth1,option:ntp-server,192.168.1.1
dhcp-option=tag:s_eth1,option:domain-name,lan
dhcp-ignore-names=tag:s_eth1
dhcp-range=set:s_eth2,192.168.2.100,192.168.2.150,255.255.255.0,24h
dhcp-option=tag:s_eth2,option:router,192.168.2.1
dhcp-option=tag:s_eth2,option:dns-server,192.168.2.1
dhcp-option=tag:s_eth2,option:ntp-server,192.168.2.1
dhcp-option=tag:s_eth2,option:domain-name,lan
dhcp-ignore-names=tag:s_eth2
dhcp-range=set:s_eth3,10.30.0.100,10.30.0.150,255.255.255.0,24h
dhcp-option=tag:s_eth3,option:router,10.30.0.1
dhcp-option=tag:s_eth3,option:dns-server,10.30.0.1
dhcp-option=tag:s_eth3,option:domain-name,lan
dhcp-ignore-names=tag:s_eth3
enable-ra
dhcp-range=set:s6_eth1,::,constructor:eth1,ra-stateless,64,24h
dhcp-option=tag:s6_eth1,option6:dns-server,[2001:db8:1::1]
dhcp-option=tag:s6_eth1,option6:ntp-server,[2001:db8:1::1]
dhcp-option=tag:s6_eth1,option6:domain-search,lan
dhcp-range=set:s6_eth2,::100,::1ff,constructor:eth2,64,24h
dhcp-ignore-names=tag:dhcpv6,tag:eth2
dhcp-option=tag:s6_eth2,option6:dns-server,[::]
dhcp-option=tag:s6_eth2,option6:ntp-server,[::]
dhcp-option=tag:s6_eth2,option6:domain-search,lan
dhcp-range=set:s6_eth3,::,constructor:eth3,ra-stateless,64,24h
dhcp-option=tag:s6_eth3,option6:dns-server,[::]
dhcp-option=tag:s6_eth3,option6:domain-search,lan
==> ostiole.enabled <==
1
==> ostiole.hosts <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
==> resolv.conf <==
# Generated by ostiole.
nameserver 127.0.0.1
search lan
