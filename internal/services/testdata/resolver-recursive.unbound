==> ostiole.conf <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
server:
    verbosity: 0
    use-syslog: yes
    log-queries: no
    log-replies: no
    log-servfail: no
    interface: 127.0.0.53@53
    do-ip4: yes
    do-ip6: yes
    do-udp: yes
    do-tcp: yes
    access-control: 0.0.0.0/0 refuse
    access-control: 127.0.0.0/8 allow
    access-control: ::0/0 refuse
    username: "unbound"
    directory: "/etc/unbound"
    chroot: ""
    hide-identity: yes
    hide-version: yes
    hide-trustanchor: yes
    harden-glue: yes
    harden-dnssec-stripped: yes
    harden-below-nxdomain: yes
    harden-algo-downgrade: yes
    harden-large-queries: yes
    harden-short-bufsize: yes
    unwanted-reply-threshold: 10000
    deny-any: yes
    val-clean-additional: yes
    use-caps-for-id: yes
    minimal-responses: yes
    qname-minimisation: yes
    aggressive-nsec: yes
    prefetch: yes
    rrset-roundrobin: yes
    edns-buffer-size: 1232
    cache-min-ttl: 60
    msg-cache-size: 32m
    rrset-cache-size: 64m
    private-address: 10.0.0.0/8
    private-address: 172.16.0.0/12
    private-address: 192.168.0.0/16
    private-address: 169.254.0.0/16
    private-address: fd00::/8
    private-address: fe80::/10
    private-address: ::ffff:0:0/96
    private-domain: "lan"
    private-domain: "nas.example.com"
    private-domain: "ts.net"
    auto-trust-anchor-file: "/var/lib/unbound/root.key"

auth-zone:
    name: "."
    primary: 199.9.14.201
    primary: 2001:500:200::b
    primary: 192.33.4.12
    primary: 2001:500:2::c
    primary: 199.7.91.13
    primary: 2001:500:2d::d
    primary: 192.5.5.241
    primary: 2001:500:2f::f
    primary: 192.112.36.4
    primary: 2001:500:12::d0d
    primary: 193.0.14.129
    primary: 2001:7fd::1
    primary: 192.0.47.132
    primary: 2620:0:2830:202::132
    primary: 192.0.32.132
    primary: 2620:0:2d0:202::132
    fallback-enabled: yes
    for-downstream: no
    for-upstream: yes
    zonefile: "/var/lib/unbound/root.zone"
