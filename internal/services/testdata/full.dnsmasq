==> dnsmasq.conf <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
no-resolv
no-hosts
no-poll
bind-dynamic
addn-hosts=/var/lib/ostiole/dnsmasq/hosts
dhcp-leasefile=/var/lib/ostiole/dnsmasq.leases
domain-needed
bogus-priv
localise-queries
interface=eth1
interface=eth1.20
interface=eth2
listen-address=127.0.0.1
server=1.1.1.1
server=2606:4700:4700::1111
domain=lan
local=/lan/
expand-hosts
dhcp-authoritative
dhcp-range=set:s_eth1,192.168.1.100,192.168.1.199,255.255.255.0,12h
dhcp-option=tag:s_eth1,option:router,192.168.1.1
dhcp-option=tag:s_eth1,option:dns-server,192.168.1.1
dhcp-option=tag:s_eth1,option:domain-name,lan
dhcp-host=aa:bb:cc:dd:ee:ff,192.168.1.50,nas
==> dnsmasq.enabled <==
1
==> hosts <==
# Generated by ostiole. Do not edit; changes are overwritten on apply.
192.168.1.60 printer
192.168.1.50 nas
==> resolv.conf <==
# Generated by ostiole.
nameserver 127.0.0.1
search lan
