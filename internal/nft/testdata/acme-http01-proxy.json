{
  "version": 6,
  "system": {
    "hostname": "acme-proxy-fw",
    "management": {
      "webPort": 8443,
      "sshPort": 22,
      "certificate": "router"
    }
  },
  "zones": [
    {
      "name": "wan",
      "external": true
    },
    {
      "name": "lan",
      "antiLockout": true
    }
  ],
  "interfaces": [
    {
      "name": "eth0",
      "zone": "wan",
      "enabled": true,
      "ipv4": {
        "mode": "dhcp"
      },
      "ipv6": {
        "mode": "slaac"
      }
    },
    {
      "name": "eth1",
      "zone": "lan",
      "enabled": true,
      "ipv4": {
        "mode": "static",
        "address": "192.168.1.1/24"
      },
      "ipv6": {
        "mode": "none"
      }
    }
  ],
  "rules": [
    {
      "id": "lan-out",
      "description": "Allow LAN to any",
      "enabled": true,
      "zone": "lan",
      "action": "accept",
      "protocol": "any",
      "source": {},
      "destination": {}
    }
  ],
  "nat": {
    "outbound": {
      "mode": "automatic"
    }
  },
  "services": {
    "dhcp": {
      "enabled": false
    },
    "dns": {
      "enabled": false
    },
    "proxy": {
      "enabled": true,
      "pools": [
        {
          "id": "web",
          "upstreams": [
            {
              "address": "192.168.1.20:8080"
            }
          ]
        }
      ],
      "sites": [
        {
          "id": "shop",
          "enabled": true,
          "hosts": [
            "shop.example.com"
          ],
          "pool": "web",
          "certificate": "router"
        }
      ]
    }
  },
  "acme": {
    "accounts": [
      {
        "id": "staging",
        "directory": "https://acme-staging-v02.api.letsencrypt.org/directory",
        "privateKey": ""
      }
    ]
  },
  "certificates": [
    {
      "id": "router",
      "description": "The public address this router answers on",
      "enabled": true,
      "source": "acme",
      "interfaceAddresses": [
        "eth0"
      ],
      "account": "staging",
      "challenge": "http-01"
    }
  ]
}
