{
  "version": 16,
  "system": {
    "hostname": "proxy-fw",
    "management": {
      "webPort": 8443,
      "sshPort": 22
    }
  },
  "zones": [
    {
      "name": "wan",
      "external": true
    },
    {
      "name": "lan",
      "antiLockout": true
    }
  ],
  "interfaces": [
    {
      "name": "eth0",
      "zone": "wan",
      "enabled": true,
      "ipv4": {
        "mode": "dhcp"
      },
      "ipv6": {
        "mode": "slaac"
      }
    },
    {
      "name": "eth1",
      "zone": "lan",
      "enabled": true,
      "ipv4": {
        "mode": "static",
        "address": "192.168.1.1/24"
      },
      "ipv6": {
        "mode": "none"
      }
    }
  ],
  "rules": [
    {
      "id": "lan-out",
      "description": "Allow LAN to any",
      "enabled": true,
      "zone": "lan",
      "action": "accept",
      "protocol": "any",
      "source": {},
      "destination": {}
    }
  ],
  "nat": {
    "outbound": {
      "mode": "automatic"
    }
  },
  "services": {
    "dhcp": {
      "enabled": false
    },
    "dns": {
      "enabled": false
    },
    "proxy": {
      "enabled": true,
      "access": [
        {
          "id": "wan",
          "enabled": true,
          "zone": "wan",
          "ports": ["http", "https"],
          "source": {},
          "action": "accept"
        }
      ],
      "http3": true,
      "pools": [
        {
          "id": "web",
          "upstreams": [{ "address": "192.168.1.20:8080" }]
        }
      ],
      "sites": [
        {
          "id": "shop",
          "enabled": true,
          "hosts": ["shop.example.com"],
          "pool": "web"
        }
      ]
    }
  }
}
