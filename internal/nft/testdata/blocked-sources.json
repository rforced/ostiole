{
  "version": 3,
  "system": {
    "hostname": "hardened",
    "management": {
      "webPort": 443,
      "sshPort": 22,
      "logDefaultDrops": true
    }
  },
  "zones": [
    {
      "name": "wan",
      "external": true,
      "antiLockout": true
    },
    {
      "name": "lan",
      "antiLockout": true
    },
    {
      "name": "iot"
    }
  ],
  "interfaces": [
    {
      "name": "eth0",
      "zone": "wan",
      "description": "The internet",
      "enabled": true,
      "ipv4": {
        "mode": "dhcp"
      },
      "ipv6": {
        "mode": "slaac"
      },
      "blockPrivate": true,
      "blockBogons": true
    },
    {
      "name": "eth1",
      "zone": "lan",
      "enabled": true,
      "ipv4": {
        "mode": "static",
        "address": "192.168.1.1/24"
      },
      "ipv6": {
        "mode": "static",
        "address": "2001:db8:1::1/64"
      },
      "logDrops": false
    },
    {
      "name": "eth2",
      "zone": "iot",
      "description": "Noisy, and worth watching",
      "enabled": true,
      "ipv4": {
        "mode": "static",
        "address": "192.168.9.1/24"
      },
      "ipv6": {
        "mode": "none"
      }
    }
  ],
  "rules": [
    {
      "id": "lan-out",
      "enabled": true,
      "zone": "lan",
      "action": "accept",
      "protocol": "any",
      "source": {},
      "destination": {}
    }
  ],
  "nat": {
    "outbound": {
      "mode": "automatic"
    }
  },
  "services": {
    "dhcp": {
      "enabled": false
    },
    "dns": {
      "enabled": false
    }
  }
}
