{
  "version": 7,
  "system": {
    "hostname": "logger",
    "management": {
      "webPort": 443,
      "sshPort": 22
    }
  },
  "zones": [
    {
      "name": "wan",
      "external": true,
      "antiLockout": true
    },
    {
      "name": "lan",
      "antiLockout": true,
      "logDrops": true
    },
    {
      "name": "guest",
      "description": "Logs nothing, so the shared block_dns chain has to tell the two apart"
    }
  ],
  "interfaces": [
    {
      "name": "eth0",
      "zone": "wan",
      "enabled": true,
      "ipv4": { "mode": "dhcp" },
      "ipv6": { "mode": "slaac" }
    },
    {
      "name": "eth1",
      "zone": "lan",
      "enabled": true,
      "ipv4": { "mode": "static", "address": "192.168.1.1/24" },
      "ipv6": { "mode": "static", "address": "2001:db8:1::1/64" }
    },
    {
      "name": "eth2",
      "zone": "guest",
      "enabled": true,
      "ipv4": { "mode": "static", "address": "192.168.9.1/24" },
      "ipv6": { "mode": "none" }
    }
  ],
  "aliases": [
    {
      "name": "doh_servers",
      "type": "hosts",
      "description": "Public DNS over HTTPS resolvers",
      "url": "https://example.test/doh-ipv4.txt",
      "refreshHours": 24,
      "entries": []
    }
  ],
  "protection": {
    "zones": ["lan", "guest"],
    "synFlood": { "rate": 30, "unit": "second", "burst": 60, "perSource": true },
    "icmpFlood": { "rate": 10, "unit": "second", "burst": 20, "perSource": true },
    "portScan": { "rate": 20, "unit": "minute", "hold": "10m" }
  },
  "rules": [
    {
      "id": "lan-out",
      "enabled": true,
      "zone": "lan",
      "action": "accept",
      "protocol": "any",
      "source": {},
      "destination": {}
    },
    {
      "id": "guest-out",
      "enabled": true,
      "zone": "guest",
      "action": "accept",
      "protocol": "any",
      "source": {},
      "destination": {}
    }
  ],
  "nat": { "outbound": { "mode": "automatic" } },
  "blocking": {
    "enforce": {
      "blockDot": true,
      "dohAlias": "doh_servers"
    }
  }
}
