{
  "version": 6,
  "system": {
    "hostname": "shaped",
    "management": {
      "webPort": 443,
      "sshPort": 22
    }
  },
  "zones": [
    {
      "name": "wan",
      "external": true
    },
    {
      "name": "lan",
      "antiLockout": true
    },
    {
      "name": "guest"
    }
  ],
  "interfaces": [
    {
      "name": "eth0",
      "zone": "wan",
      "enabled": true,
      "ipv4": {
        "mode": "dhcp"
      },
      "ipv6": {
        "mode": "none"
      },
      "shaping": {
        "download": 200000000,
        "upload": 20000000
      }
    },
    {
      "name": "eth1",
      "zone": "lan",
      "enabled": true,
      "ipv4": {
        "mode": "static",
        "address": "192.168.1.1/24"
      },
      "ipv6": {
        "mode": "none"
      },
      "shaping": {
        "download": 50000000,
        "upload": 50000000
      }
    },
    {
      "name": "eth1.30",
      "zone": "guest",
      "enabled": true,
      "vlan": {
        "parent": "eth1",
        "id": 30
      },
      "ipv4": {
        "mode": "static",
        "address": "192.168.30.1/24"
      },
      "ipv6": {
        "mode": "none"
      },
      "shaping": {
        "download": 10000000,
        "link": "docsis"
      }
    },
    {
      "name": "eth2.7",
      "enabled": true,
      "vlan": {
        "parent": "eth2",
        "id": 7
      },
      "ipv4": {
        "mode": "none"
      },
      "ipv6": {
        "mode": "none"
      }
    },
    {
      "name": "dsl",
      "zone": "wan",
      "enabled": true,
      "pppoe": {
        "parent": "eth2.7",
        "username": "user",
        "password": "secret"
      },
      "ipv4": {
        "mode": "ppp"
      },
      "ipv6": {
        "mode": "none"
      },
      "shaping": {
        "download": 100000000,
        "upload": 40000000,
        "link": "pppoe-ptm"
      }
    },
    {
      "name": "enp0s31f6.4000",
      "zone": "lan",
      "enabled": true,
      "vlan": {
        "parent": "eth1",
        "id": 4000
      },
      "ipv4": {
        "mode": "static",
        "address": "192.168.40.1/24"
      },
      "ipv6": {
        "mode": "none"
      },
      "shaping": {
        "download": 1000000000,
        "upload": 1000000000,
        "link": "conservative"
      }
    },
    {
      "name": "eth3",
      "zone": "guest",
      "enabled": false,
      "ipv4": {
        "mode": "static",
        "address": "192.168.9.1/24"
      },
      "ipv6": {
        "mode": "none"
      },
      "shaping": {
        "download": 5000000,
        "upload": 5000000
      }
    }
  ],
  "rules": [
    {
      "id": "lan-out",
      "enabled": true,
      "zone": "lan",
      "action": "accept",
      "protocol": "any",
      "source": {},
      "destination": {}
    }
  ],
  "nat": {
    "outbound": {
      "mode": "automatic"
    }
  },
  "services": {
    "dhcp": {
      "enabled": false
    },
    "dns": {
      "enabled": false
    }
  }
}
